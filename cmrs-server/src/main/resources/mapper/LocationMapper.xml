<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cmrs.mapper.LocationMapper">
    <update id="update" parameterType="Location">
        update repair_location
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>


    <select id="list" resultType="LocationVO">
        select * from repair_location order by id
    </select>


    <select id="getByParentId" resultType="Location">
        select * from repair_location where parent_id = #{id}
    </select>
</mapper>