<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cmrs.mapper.CategoryMapper">
    <update id="update" parameterType="Category">
        update fault_category
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="description != null">description = #{description},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>


    <select id="list" resultType="CategoryVO">
        select * from fault_category order by id
    </select>

<!--    <select id="getCategoryLevel1" resultType="CategoryVO">-->
<!--        select * from fault_category where parent_id = 0 order by id-->
<!--    </select>-->


    <select id="getByParentId" resultType="Category">
        select * from fault_category where parent_id = #{id}
    </select>
</mapper>