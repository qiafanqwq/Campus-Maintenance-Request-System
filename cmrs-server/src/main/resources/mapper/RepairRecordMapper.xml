<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cmrs.mapper.RepairRecordMapper">
    <update id="update" parameterType="RepairRecord">
        update repair_record
        <set>
            <if test="repairmanId != null">repairman_id = #{repairmanId},</if>
            <if test="repairmanName != null">repairman_name = #{repairmanName},</if>
            <if test="repairTime != null">repair_time = #{repairTime},</if>
            <if test="repairProcess != null">repair_process = #{repairProcess},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where rr_id = #{rrId}
    </update>

    <select id="getByRepairmanId" resultType="RepairRecord">
        select * from repair_record where repairman_id = #{repairmanId}
    </select>


    <!-- 查询所有维修记录 -->
    <select id="selectAllRecordsByOrderId" resultType="RepairRecord">
        SELECT * FROM repair_record
        WHERE order_id = #{orderId}
        ORDER BY create_time ASC
    </select>
</mapper>